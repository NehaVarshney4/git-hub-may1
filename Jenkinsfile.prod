pipeline {
    agent { label 'PROD' }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout Master Branch') {
            steps {
                checkout scm
            }
        }
        stage('Deploy to Prod Server') {
            steps {
                echo "Ensuring target deployment directory exists..."
                
                // Add this line to create the directory if it doesn't exist (-p flag)
                sh 'mkdir -p /var/www/production-site/'

                echo "Copying files to the production server workspace..."
                // The 'cp' command will now succeed
                sh 'cp -R * /var/www/production-site/'
            }
        }
    }
}
