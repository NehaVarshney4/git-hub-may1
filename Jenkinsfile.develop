pipeline {
    // We orchestrate the stages from the master, running specific stages on specific agents
    agent none

    triggers {
        // This listens for the push event from GitHub
        githubPush() 
    }

    stages {
        stage('Deploy to Test Node') {
            // This stage runs entirely on the node labeled 'TEST'
            agent { 
                label 'TEST' 
            }
            steps {
                echo "--- Starting deployment to TEST server ---"
                // Checkout the SCM details defined in the Jenkins job config (develop branch)
                checkout scm 

                sh 'mkdir -p /var/www/test-site/'
                sh 'cp -R * /var/www/test-site/'
                echo "Deployment to TEST node complete."
            }
        }

        stage('Deploy to Production Node') {
            agent { 
                label 'PROD' 
            }
            steps {
                echo "Ensuring target deployment directory exists and is owned by Jenkins user..."
                // Ensure directory is created and permissions are set correctly first
                sh 'mkdir -p /var/www/production-site/'
                sh 'sudo chown -R ubuntu:ubuntu /var/www/production-site/' 

                echo "Copying application files (excluding .git) to the production server..."
                
                // Use rsync for a more robust sync or find to exclude .git
                // A simple shell script workaround:
                sh '''
                rsync -av --exclude='.git*' . /var/www/production-site/
                '''

                echo "Deployment to PROD node complete."
            }
        }
    }
}
